{
  "name": "ecowaste-backend",
  "version": "1.0.0",
  "description": "Production-ready EcoWaste backend API built with Express, TypeScript, and PostgreSQL.",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-migrations.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "npm run build && node dist/utils/migrate.js",
    "seed": "npm run build && node dist/utils/seed.js",
    "start": "node dist/server.js",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "npm run build && node tests/dispatch-offer-phase2.integration.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.2",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
