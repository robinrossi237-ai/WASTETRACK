# WasteTrack Backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Environment: development | test | production
NODE_ENV=development

# HTTP port the server listens on
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://wastetrack:wastetrack_password@localhost:5432/ecowaste_db

# Enable TLS to PostgreSQL (set true on Neon / Supabase / other cloud hosts)
DATABASE_SSL=false

# Secret used to sign JWTs. Use a long, random value in production
# (e.g. `openssl rand -hex 64`).
JWT_SECRET=change_me_to_a_long_random_secret

# JWT lifetime
JWT_EXPIRES_IN=7d

# bcrypt cost factor (4-15)
BCRYPT_SALT_ROUNDS=12

# Optional: require a shared secret on the public signup route
# (leave empty/unset to allow open signup)
SIGNUP_SECRET=

# Comma-separated list of allowed CORS origins for the browser apps
# e.g. https://wastetrack.example.com
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Expo push notification endpoint and optional access token
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Rate limiting (ms window, request caps)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTHENTICATED_MAX=600
AUTH_RATE_LIMIT_MAX=20

# How often (ms) the pickup-overdue sweep runs
PICKUP_OVERDUE_SWEEP_MS=60000
