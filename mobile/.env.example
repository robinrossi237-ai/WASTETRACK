# WasteTrack Mobile configuration.
# Copy to `.env.local` for local development. For the web build, these are
# inlined at build time (EXPO_PUBLIC_* is available in the client bundle).

# Base URL of the WasteTrack backend API (used by the web build / web preview).
# Note: for the hosted native app, point this at a publicly reachable backend.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Map features are fully keyless by default:
#   - Geocoding / reverse geocoding: OpenStreetMap Nominatim (free, no key)
#   - Street routing: OSRM public server (free, no key)
#   - Map tiles: OpenFreeMap / OpenStreetMap (free, no key)
# No key is required for the map to work.

# OPTIONAL: GraphHopper routing fallback. If set, GraphHopper is used as a
# secondary routing provider only when OSRM fails. Leave blank to skip.
# EXPO_PUBLIC_GRAPHHOPPER_KEY=

# Optional legacy override (kept for compatibility)
# EXPO_PUBLIC_DOMAIN=

# Optional EAS project id for push notifications
# EXPO_PUBLIC_EAS_PROJECT_ID=
